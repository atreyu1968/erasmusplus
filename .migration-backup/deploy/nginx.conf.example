# PLANTILLA: no habilitar sin dominio, certificado y validación TIC.
# Sustituir el subdominio de ejemplo y las rutas de certificado.
server {
    listen 80;
    server_name erasmus.SUBDOMINIO-INSTITUCIONAL.example;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    server_name erasmus.SUBDOMINIO-INSTITUCIONAL.example;

    ssl_certificate /RUTA/DEL/CERTIFICADO/fullchain.pem;
    ssl_certificate_key /RUTA/DE/LA/CLAVE/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 1m;
    add_header X-Content-Type-Options nosniff always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security 'max-age=31536000' always;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_read_timeout 30s;
    }
}
