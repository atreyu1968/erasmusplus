# Plantilla: adaptar rutas y permisos antes de usar.
[Unit]
Description=Movilidades Erasmus+ MMG (Node.js + SQLite)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=erasmusmmg
Group=erasmusmmg
WorkingDirectory=/opt/erasmusplus
EnvironmentFile=/etc/erasmusplus/erasmusplus.env
ExecStart=/usr/bin/node /opt/erasmusplus/src/server.mjs
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/erasmusplus
CapabilityBoundingSet=
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
