# Ejemplo (no incluir contraseñas reales en GitHub)
HOST=127.0.0.1
PORT=3000
MMG_DATA_DIR=./data
MMG_SECRET=CAMBIAR_POR_CLAVE_ALEATORIA_DE_AL_MENOS_48_CARACTERES
MMG_ENV=development
MMG_SECURE_COOKIE=0
# El registro real requiere revisión legal y habilitación deliberada
MMG_ENABLE_REGISTRATION=0
MMG_PRIVACY_VERSION=PENDIENTE_REVISION
# Alta inicial: definir variables solo durante el comando init-admin
MMG_ADMIN_USERNAME=
MMG_ADMIN_PASSWORD=
MMG_ADMIN_EMAIL=

# AVISO DE PRIVACIDAD: configuracion obligatoria aprobada por el responsable
MMG_PRIVACY_CONTROLLER=
MMG_PRIVACY_CONTACT=
MMG_PRIVACY_DPO=
MMG_PRIVACY_LEGAL_BASIS=
MMG_PRIVACY_RETENTION=
MMG_PRIVACY_RECIPIENTS=
# El registro no se habilitara hasta completar esos campos y validar version.
# Passkeys: solo cuando exista subdominio HTTPS final y autorizado
MMG_PASSKEY_RPID=
MMG_PASSKEY_ORIGIN=
