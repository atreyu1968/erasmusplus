modules = ["nodejs-24"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[userenv]

[userenv.development]
HOST = "0.0.0.0"
MMG_ENABLE_REGISTRATION = "0"
MMG_ENV = "development"
MMG_SECURE_COOKIE = "1"
PORT = "5000"
