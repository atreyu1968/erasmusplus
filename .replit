modules = ["bash", "nodejs-24"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[userenv]

[userenv.development]
HOST = "0.0.0.0"
MMG_ENABLE_REGISTRATION = "0"
MMG_ENV = "development"
MMG_SECURE_COOKIE = "1"
PORT = "5000"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "MMG_SECRET=\"${MMG_SECRET:-$SESSION_SECRET}\" npm start"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80
